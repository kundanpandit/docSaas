# Copy to deploy/.env ON THE SERVER ONLY (never commit it): cp .env.example .env && chmod 600 .env
# setup-server.sh fills the four generated secrets automatically.

# ---- generated (fresh random values; never reuse the development ones) ----
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
JOBRUNR_DASHBOARD_PASSWORD=

# ---- domains ----
API_DOMAIN=api.docsaas.in
FRONTEND_URL=https://docsaas.in
CORS_ALLOWED_ORIGINS=https://docsaas.in,https://www.docsaas.in

# ---- Google sign-in (public client id; also add https://docsaas.in in Google Cloud Console) ----
GOOGLE_CLIENT_ID=

# ---- AI (Gemini) ----
AI_API_KEY=
AI_MODEL=gemini-3.5-flash

# ---- Email (Brevo once docsaas.in is verified there; Gmail works meanwhile) ----
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=DocSaaS <no-reply@docsaas.in>

# ---- capacity ----
JOB_WORKERS=2
